FROM python:3.12-slim@sha256:cab2dbf575e971934a81e4622f5aba17aa7929719bd7e31033a3a83b97fd0464
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app PYTHONHASHSEED=0
WORKDIR /app
COPY docx_sandbox/job/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r /app/requirements.lock
COPY docx_sandbox/job/entrypoint.py /app/entrypoint.py
RUN useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin sandbox
USER 65532:65532
ENTRYPOINT ["python", "-I", "/app/entrypoint.py"]
